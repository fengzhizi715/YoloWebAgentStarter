# Runtime state. Relative paths are resolved from the repository root.
YWA_DATA_DIR=./data

# Directories submitted to the scan API must resolve below this root.
YWA_IMPORT_ROOT=./data/imports

# Optional explicit SQLAlchemy URL. SQLite is the only supported database in Starter v1.
# YWA_DATABASE_URL=sqlite:////absolute/path/to/yolowebagent-starter.db

YWA_HOST=127.0.0.1
YWA_PORT=8000
YWA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
YWA_MAX_UPLOAD_MB=50
# Video imports are staged and extracted asynchronously. Limits below use MB except duration and frame count.
YWA_MAX_VIDEO_UPLOAD_MB=2048
YWA_MAX_VIDEO_DURATION_SECONDS=14400
YWA_MAX_VIDEO_GENERATED_IMAGES=100000
YWA_MAX_VIDEO_OUTPUT_MB=51200
YWA_MIN_VIDEO_FREE_MB=2048

# YOLO ZIP defence-in-depth limits.  These apply to the uncompressed archive,
# before any member is written to managed storage.
YWA_MAX_YOLO_ARCHIVE_MEMBERS=2000
YWA_MAX_YOLO_ARCHIVE_MEMBER_MB=100
YWA_MAX_YOLO_ARCHIVE_UNCOMPRESSED_MB=250
YWA_MAX_YOLO_ARCHIVE_COMPRESSION_RATIO=100

# Optional override for the local Ultralytics executable, useful for a reviewed
# virtual environment or a deterministic test runner.
# YWA_YOLO_EXECUTABLE=/absolute/path/to/.venv/bin/yolo

# Optional local or Ultralytics-recognized SAM checkpoint for interactive
# segment suggestions. Without it, box prompts use the clearly labelled
# review-only box_stub fallback; point prompts require a configured model.
# YWA_SAM_MODEL=sam_b.pt
# YWA_SAM_DEVICE=auto
# YWA_SAM_IMGSZ=1024
